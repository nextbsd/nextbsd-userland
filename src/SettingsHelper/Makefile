# SettingsHelper — the settings apps' privileged helper (nextbsd/nextbsd#628).
#
# Builds /usr/libexec/SettingsHelper, which launchd starts on demand as
# org.nextbsd.SettingsHelper (overlay/System/Library/LaunchDaemons/
# org.nextbsd.SettingsHelper.plist). Its rules are in overlay/System/
# Library/Security/SettingsRights.plist and its PAM service in
# overlay/private/etc/pam.d/authorization.
#
# /usr/libexec, not /usr/sbin: nobody runs it by hand; launchd does, as
# macOS's helpers live in /usr/libexec. /System/Library holds data only.
#
# Build:   cd src/SettingsHelper && make SYSROOT=/path/to/rootfs MIGOUT=/path/to/migout
# Install: make DESTDIR=/path/to/rootfs install
#
# The client stubs aren't built here: the settings apps generate their own
# from a copy of settingshelper.defs and settingshelper_types.h
# (apps-settings Frameworks/NBSettings/mig), as Bluetooth.app does for
# bluetooth.defs.

PROG=		SettingsHelper
MAN=		SettingsHelper.8
SRCS=		SettingsHelper.c sh_session.c sh_auth.c sh_rights.c sh_pm.c
SRCS+=		sh_time.c
SRCS+=		sh_mig.c
BINDIR=		/usr/libexec

# settingshelperServer.c — the MIG server stub, generated by
# build-userland.sh into MIGOUT, as wland's is. -w on it: MIG output isn't
# WARNS-clean. -Wno-macro-redefined: <mach/notify.h> and <mach/message.h>
# both define the MACH_NOTIFY_* macros (see src/WLAN/Makefile).
MIGOUT?=
.if empty(MIGOUT)
.error MIGOUT must name the directory holding settingshelperServer.c (build-userland.sh)
.endif
.PATH:				${MIGOUT}
SRCS+=				settingshelperServer.c
CFLAGS+=			-I${MIGOUT}
CFLAGS+=			-I${.CURDIR}	# the stubs #include "settingshelper_types.h"
CFLAGS.settingshelperServer.c+=	-w
CFLAGS+=			-Wno-macro-redefined

# WARNS=0: sh_rights.c and sh_pm.c pull the CoreFoundation and IOKit
# header trees, whose warnings -Wsystem-headers -Werror would make fatal
# (the same carry as wland and pmset).
WARNS=		0
CFLAGS+=	-O2 -pipe -fblocks
CFLAGS+=	-Wall -Wextra -Wshadow -Wstrict-prototypes
CFLAGS+=	-Wmissing-prototypes -Wpointer-arith

# libIOKit's own headers (IOPMLibPrivate.h for IOPMCopyPMPreferences and
# IOPMSetPMPreferences), and liblaunch's <servers/bootstrap.h>.
CFLAGS+=	-I${.CURDIR}/../libIOKit
CFLAGS+=	-I${.CURDIR}/../launchd/liblaunch
CFLAGS+=	-I${.CURDIR}/../launchd/freebsd-shims
# <notify.h> (sh_time.c) includes os/base.h from the libnotify shims, as
# bluetoothd's and ipconfigd's do.
CFLAGS+=	-I${.CURDIR}/../Libnotify/freebsd-shims

SYSROOT?=
.if !empty(SYSROOT)
CFLAGS+=	-I${SYSROOT}/usr/include
LDFLAGS+=	-L${SYSROOT}/usr/lib/system
LDFLAGS+=	-Wl,-rpath,/usr/lib/system
LDFLAGS+=	-Wl,--allow-shlib-undefined
.endif

#   -lIOKit -lCoreFoundation   IOPMCopyPMPreferences / IOPMSetPMPreferences,
#                              and the rules plists
#   -llaunch                   bootstrap_check_in
#   -lsystem_kernel            mach_msg
#   -lsystem_dispatch, blocks  pulled in by libIOKit and CF
#   -lnotify                   com.apple.system.timezone and clock_set
LDADD+=		-lIOKit -lCoreFoundation -llaunch -lsystem_kernel -lnotify
LDADD+=		-lsystem_dispatch -l:libsystem_blocks.so
LIBADD+=	pam

.include <bsd.prog.mk>
