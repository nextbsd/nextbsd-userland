/*
 * ipconfig.defs — Mach-RPC interface to ipconfigd.
 *
 * NextBSD port. Slimmed from Apple's bootp/bootplib/ipconfig.defs
 * (~21 routines). Routine ORDER and msgh_id values (subsystem base
 * 20000) match Apple: every Apple routine we do not carry yet is a
 * `skip;` in its slot, so the ids line up with a real macOS dtrace and
 * a later routine lands by turning its skip back into a routine —
 * never by reordering.
 *
 *   20000  ipconfig_if_count		ipconfig ifcount
 *   20001  ipconfig_get_option		ipconfig getoption (#59)
 *   20002  ipconfig_if_addr		ipconfig getifaddr
 *   20004  ipconfig_set		ipconfig set (#59)
 *   20017  ipconfig_get_summary	ipconfig getsummary (#59)
 *
 * The vendored routines are Apple's as-is: out-of-line `^ array []`
 * xmlData / xmlDataOut / dataOut payloads (as config.defs carries them
 * since nextbsd#354) and the `ServerAuditToken audit_token` decorator
 * where Apple has one. The server vm_deallocate()s an xmlData argument
 * it receives and hands replies back in vm_allocate()d buffers that
 * `dealloc` releases on send; mach_service.c receives with the audit
 * trailer so the MIG demux can hand the token over.
 *
 * The server demux _ipconfig_server() runs inside ipconfigd's
 * mach_service_thread receive loop. Per-routine implementations are
 * in ipconfigd_mig.c.
 *
 * Apple's ipconfig.defs uses `subsystem ipconfig 20000;` — the same
 * subsystem base as configd's `subsystem config 20000;`. The two
 * never share a port set, so the id collision is harmless; keeping
 * Apple's id makes msgh_id values match a real macOS dtrace.
 */

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

subsystem ipconfig 20000;
serverprefix _;

import "ipconfig_mig_types.h";

/* The Apple-original named types. */
type ip_address		= MACH_MSG_TYPE_INTEGER_32 ctype: ip_address_t;
type ipconfig_status	= MACH_MSG_TYPE_INTEGER_32 ctype: ipconfig_status_t;
type if_name		= array[16] of char ctype: InterfaceName;

/* serialized XML data (client->server) */
type xmlData		= ^ array [] of MACH_MSG_TYPE_BYTE
	ctype : xmlData_t;

/* serialized XML data (server->client) */
type xmlDataOut		= ^ array [] of MACH_MSG_TYPE_BYTE
	ctype : xmlDataOut_t;

/* serialized data out (server->client) */
type dataOut		= ^ array [] of MACH_MSG_TYPE_BYTE
	ctype : dataOut_t;

/*
 * ipconfig_if_count — how many interfaces currently hold a lease.
 */
routine ipconfig_if_count(
	server		: mach_port_t;
	out count	: int
);

/*
 * ipconfig_get_option — the raw bytes of DHCP option `option_code`
 * from `name`'s lease. An empty `name` searches every bound interface,
 * as Apple's does. status = not_found_e if the lease did not carry the
 * option, interface_does_not_exist_e if nothing is bound on `name`.
 */
routine ipconfig_get_option(
	server		: mach_port_t;
	name		: if_name;
	option_code	: int;
	out option_data	: dataOut, dealloc;
	out status	: ipconfig_status
);

/*
 * ipconfig_if_addr — the bound IPv4 address for `name` (network
 * byte order, packed as a uint32_t). status = success_e if `name`
 * is BOUND, no_server_e otherwise.
 */
routine ipconfig_if_addr(
	server		: mach_port_t;
	name		: if_name;
	out addr	: ip_address;
	out status	: ipconfig_status
);

	skip;	/* 20003 ipconfig_get_packet */

/*
 * ipconfig_set — set `name`'s configuration method. `method_data` is
 * a serialized property list, exactly Apple's: empty for NONE, else an
 * IPv4 dictionary keyed by ConfigMethod (or {IPv4|IPv6 = {}} for
 * NONE-V4 / NONE-V6). Root only.
 */
routine ipconfig_set(
	server		: mach_port_t;
	name		: if_name;
	method_data	: xmlData;
	out status	: ipconfig_status;
	ServerAuditToken audit_token : audit_token_t
);

	skip;	/* 20005 ipconfig_set_verbose */
	skip;	/* 20006 ipconfig_set_something (IPCONFIG_TEST_NO_ENTRY) */
	skip;	/* 20007 ipconfig_add_service */
	skip;	/* 20008 (skipped in Apple's defs too) */
	skip;	/* 20009 ipconfig_find_service */
	skip;	/* 20010 ipconfig_remove_service */
	skip;	/* 20011 ipconfig_set_service */
	skip;	/* 20012 ipconfig_get_v6_packet */
	skip;	/* 20013 ipconfig_remove_service_on_interface */
	skip;	/* 20014 ipconfig_refresh_service */
	skip;	/* 20015 ipconfig_forget_network */
	skip;	/* 20016 ipconfig_get_ra */

/*
 * ipconfig_get_summary — `name`'s whole per-interface state as a
 * serialized property list (Apple's IFStateCopySummary shape).
 */
routine ipconfig_get_summary(
	server		: mach_port_t;
	name		: if_name;
	out state	: xmlDataOut, dealloc;
	out status	: ipconfig_status;
	ServerAuditToken audit_token : audit_token_t
);
