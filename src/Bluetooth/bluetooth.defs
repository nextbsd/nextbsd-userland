/*
 * bluetooth.defs — Mach-RPC interface to bluetoothd.
 *
 * There is no Apple original to port. Apple's equivalent surface sits inside
 * the closed bluetoothd and is reached through IOBluetooth.framework, so this
 * IDL is ours. It is shaped by the same two constraints as wlan.defs:
 *
 *   1. MIG OUT-OF-LINE DATA IS BROKEN in this kernel (ipconfig.defs). Every
 *      argument is a fixed-size array or a scalar, and lists use the flat
 *      count-then-entry(i) pattern: bt_paired_count, then bt_paired_entry(i).
 *
 *   2. Lists do not go in the dynamic store either: CONFIG_DATA_MAX caps any
 *      value at 8 KiB. State:/Bluetooth carries a summary only.
 *
 * Subsystem base 31000: configd and ipconfigd share 20000 (as Apple ships
 * them), wland has 30000, so bluetoothd takes the next range of its own.
 *
 * ---------------------------------------------------------------------------
 * HOW THIS FILE GROWS
 *
 * A routine's message id is its position in this file, so ids are stable only
 * if nothing moves. The surface is laid out in blocks, one per area, each
 * padded with `skip` to a fixed size. A later ticket replaces a `skip` in its
 * block with its routine; the ids of everything else stay put, and parallel
 * tickets edit different blocks. Rules:
 *
 *   - never reorder, rename the wire shape of, or remove a routine;
 *   - a retired routine becomes `skip`;
 *   - a block that fills up continues in the open range at the end (31100+).
 *
 *   31000-31009  daemon and controllers   status, adapter list; power,
 *                                         discoverable, name (#207)
 *   31010-31019  paired devices           list; unpair (#209), device status,
 *                                         auto-connect (#213)
 *   31020-31029  discovery                scan, scan_count, scan_entry (#208)
 *   31030-31039  pairing                  pair, pair_status, pair_confirm
 *                                         (#209; LE SMP #205 uses the same)
 *   31040-31049  connections              connect, disconnect (#213)
 *   31050-31069  diagnostics              sdp browse (#522); info, ping
 *                                         (#211)
 *   31070-31099  profiles                 HID, audio (31080-31084), HFP
 *                                         (31085-31089)
 *   31100-       open                     appended in order
 *
 * The server demux _bluetooth_server() runs inside bluetoothd's
 * mach_service_thread receive loop. Per-routine bodies are in bluetoothd_mig.c.
 */

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

subsystem bluetooth 31000;
serverprefix _;

import "bluetooth_mig_types.h";

type bt_node		= array[32] of char ctype: BTNodeName;
type bt_address		= array[32] of char ctype: BTAddressString;
type bt_name		= array[249] of char ctype: BTDeviceName;
type bt_profiles	= array[128] of char ctype: BTProfileList;
type bt_transport	= array[16] of char ctype: BTTransportName;
type bt_sdp_line		= array[256] of char ctype: BTSDPLine;
type bt_pin		= array[17] of char ctype: BTPinString;
type bt_usb_device	= array[32] of char ctype: BTUSBDeviceName;
type bt_daemon_state	= MACH_MSG_TYPE_INTEGER_32 ctype: bt_daemon_state_t;
type bt_adapter_state	= MACH_MSG_TYPE_INTEGER_32 ctype: bt_adapter_state_t;
type bt_device_state	= MACH_MSG_TYPE_INTEGER_32 ctype: bt_device_state_t;
type bt_pair_method	= MACH_MSG_TYPE_INTEGER_32 ctype: bt_pair_method_t;
type bt_status_code	= MACH_MSG_TYPE_INTEGER_32 ctype: bt_status_t;
type bt_pair_state	= MACH_MSG_TYPE_INTEGER_32 ctype: bt_pair_state_t;
type bt_firmware_state	= MACH_MSG_TYPE_INTEGER_32 ctype: bt_firmware_state_t;

/* ---- 31000-31009: daemon and controllers -------------------------------- */

/*
 * 31000 bt_status — the daemon summary: whether a controller is present, how
 * many, how many devices are paired, and the persisted policy
 * (ControllerPowerState, DiscoverableState, AutoConnect). The same facts are
 * in State:/Bluetooth.
 */
routine bt_status(
	server		: mach_port_t;
	out state	: bt_daemon_state;
	out adapters	: int;
	out paired	: int;
	out power_state	: int;
	out discoverable : int;
	out autoconnect	: int
);

/* 31001 bt_adapter_count — controllers bluetoothd follows right now. */
routine bt_adapter_count(
	server		: mach_port_t;
	out count	: int
);

/*
 * 31002 bt_adapter_info — one controller, by index. `address` and `name` are
 * empty until the controller has been brought up and read (#207).
 */
routine bt_adapter_info(
	server		: mach_port_t;
	index		: int;
	out node	: bt_node;
	out transport	: bt_transport;
	out vendor	: int;
	out product	: int;
	out state	: bt_adapter_state;
	out address	: bt_address;
	out name	: bt_name;
	out status	: bt_status_code
);

/*
 * 31003 bt_adapter_power — power a controller on or off (an empty node means
 * the first). Off disconnects every link and stops page and inquiry scan.
 * The choice is persisted as ControllerPowerState and applies to every
 * controller that arrives later.
 */
routine bt_adapter_power(
	server		: mach_port_t;
	node		: bt_node;
	on		: int;
	out status	: bt_status_code
);

/*
 * 31004 bt_adapter_discoverable — inquiry scan on or off. With seconds > 0
 * it turns itself off again after that long and is not persisted; with 0 it
 * is persisted as DiscoverableState.
 */
routine bt_adapter_discoverable(
	server		: mach_port_t;
	node		: bt_node;
	on		: int;
	seconds		: int;
	out status	: bt_status_code
);

/*
 * 31005 bt_adapter_flags — one controller's live policy, by index, and what
 * it can do (BT_ADAPTER_FEAT_*).
 */
routine bt_adapter_flags(
	server		: mach_port_t;
	index		: int;
	out powered	: int;
	out discoverable : int;
	out connectable	: int;
	out scanning	: int;
	out features	: int;
	out status	: bt_status_code
);

/*
 * 31006 bt_firmware_info — one USB device the firmware loader looked at, by
 * index (#202). index_out_of_range past the end.
 */
routine bt_firmware_info(
	server		: mach_port_t;
	index		: int;
	out device	: bt_usb_device;
	out vendor	: int;
	out product	: int;
	out state	: bt_firmware_state;
	out status	: bt_status_code
);

skip;	/* 31007 */
skip;	/* 31008 */
skip;	/* 31009 */

/* ---- 31010-31019: paired devices ---------------------------------------- */

/* 31010 bt_paired_count — devices in PairedDevices. */
routine bt_paired_count(
	server		: mach_port_t;
	out count	: int;
	out status	: bt_status_code
);

/*
 * 31011 bt_paired_entry — one paired device, by index, in address order.
 * `transports` is a BT_TRANSPORT_* mask; `profiles` is comma-separated.
 */
routine bt_paired_entry(
	server		: mach_port_t;
	index		: int;
	out address	: bt_address;
	out name	: bt_name;
	out class_of_device : int;
	out transports	: int;
	out profiles	: bt_profiles;
	out autoconnect	: int;
	out state	: bt_device_state;
	out status	: bt_status_code
);

/*
 * 31012 bt_unpair — forget a paired device: its keys, the controller's copy,
 * its PairedDevices entry, and its link if it is connected.
 */
routine bt_unpair(
	server		: mach_port_t;
	address		: bt_address;
	out status	: bt_status_code
);

/*
 * 31013 bt_device_status — one device, paired or not: its name and class,
 * its link state, the controller it is connected through, the signal in dBm
 * (127 when unknown) and the profiles running over the link now (comma-
 * separated). no_such_device when it is neither paired nor connected.
 */
routine bt_device_status(
	server		: mach_port_t;
	address		: bt_address;
	out name	: bt_name;
	out class_of_device : int;
	out state	: bt_device_state;
	out node	: bt_node;
	out rssi	: int;
	out profiles	: bt_profiles;
	out paired	: int;
	out status	: bt_status_code
);

/*
 * 31014 bt_device_autoconnect — whether a paired device is reconnected when a
 * controller powers up (PairedDevices/<addr>/AutoConnect).
 */
routine bt_device_autoconnect(
	server		: mach_port_t;
	address		: bt_address;
	on		: int;
	out status	: bt_status_code
);

skip;	/* 31015 */
skip;	/* 31016 */
skip;	/* 31017 */
skip;	/* 31018 */
skip;	/* 31019 */

/* ---- 31020-31029: discovery --------------------------------------------- */

/*
 * 31020 bt_scan — start discovery for `seconds` (clamped to 1..60; 0 means
 * 10) and return at once. A scan already running is joined. Results collect
 * in the controller's cache, names included, and
 * org.nextbsd.bluetooth.scan is posted as they change.
 */
routine bt_scan(
	server		: mach_port_t;
	node		: bt_node;
	seconds		: int;
	out status	: bt_status_code
);

/* 31021 bt_scan_count — entries in the cache, and whether a scan runs. */
routine bt_scan_count(
	server		: mach_port_t;
	node		: bt_node;
	out count	: int;
	out scanning	: int;
	out status	: bt_status_code
);

/*
 * 31022 bt_scan_entry — one cached device, by index. Holds Classic and LE
 * results alike: `transports` is a BT_TRANSPORT_* mask, `class_of_device`
 * is Classic, `appearance` is LE. `rssi` is in dBm, 127 when unknown; `age`
 * is seconds since the device was last seen.
 */
routine bt_scan_entry(
	server		: mach_port_t;
	node		: bt_node;
	index		: int;
	out address	: bt_address;
	out name	: bt_name;
	out class_of_device : int;
	out rssi	: int;
	out transports	: int;
	out appearance	: int;
	out paired	: int;
	out age		: int;
	out status	: bt_status_code
);

skip;	/* 31023 */
skip;	/* 31024 */
skip;	/* 31025 */
skip;	/* 31026 */
skip;	/* 31027 */
skip;	/* 31028 */
skip;	/* 31029 */

/* ---- 31030-31039: pairing ----------------------------------------------- */

/*
 * 31030 bt_pair — start pairing with `address`, with a legacy PIN or "".
 * Returns once it has started; bt_pair_status follows it.
 */
routine bt_pair(
	server		: mach_port_t;
	address		: bt_address;
	pin		: bt_pin;
	out status	: bt_status_code
);

/*
 * 31031 bt_pair_status — where the pairing with `address` is. While `state`
 * is waiting, `method` and `passkey` say what the user must do and
 * `expires_in` how many seconds are left; once it has ended, `result` says
 * how.
 */
routine bt_pair_status(
	server		: mach_port_t;
	address		: bt_address;
	out state	: bt_pair_state;
	out method	: bt_pair_method;
	out passkey	: int;
	out expires_in	: int;
	out result	: bt_status_code;
	out status	: bt_status_code
);

/*
 * 31032 bt_pair_confirm — answer the waiting prompt: accept or not, the
 * passkey for passkey entry, the PIN for a legacy PIN request.
 */
routine bt_pair_confirm(
	server		: mach_port_t;
	address		: bt_address;
	accept		: int;
	passkey		: int;
	pin		: bt_pin;
	out status	: bt_status_code
);

skip;	/* 31033 */
skip;	/* 31034 */
skip;	/* 31035 */
skip;	/* 31036 */
skip;	/* 31037 */
skip;	/* 31038 */
skip;	/* 31039 */

/* ---- 31040-31049: connections ------------------------------------------- */

/*
 * 31040 bt_connect — connect a device: a paired HID device gets its HID
 * channels, anything else an ACL link. Returns once the attempt has started;
 * bt_device_status follows it.
 */
routine bt_connect(
	server		: mach_port_t;
	address		: bt_address;
	out status	: bt_status_code
);

/*
 * 31041 bt_disconnect — disconnect a device: its profiles' channels, then
 * the link. A device that reconnects by itself may come back; unpair it to
 * stop that.
 */
routine bt_disconnect(
	server		: mach_port_t;
	address		: bt_address;
	out status	: bt_status_code
);

skip;	/* 31042 */
skip;	/* 31043 */
skip;	/* 31044 */
skip;	/* 31045 */
skip;	/* 31046 */
skip;	/* 31047 */
skip;	/* 31048 */
skip;	/* 31049 */

/* ---- 31050-31069: diagnostics ------------------------------------------- */

/*
 * 31050 bt_sdp_browse — browse a remote device's SDP records (what sdpcontrol
 * browse did). bluetoothd connects to the device's PSM 1, reads every record,
 * renders them as text and keeps the lines; `records` and `lines` say how
 * many. `errnum` is the errno behind a failure. Blocks for as long as the
 * device takes to answer (bounded: 20 s to connect, 5 s per response).
 */
routine bt_sdp_browse(
	server		: mach_port_t;
	address		: bt_address;
	out records	: int;
	out lines	: int;
	out errnum	: int;
	out status	: bt_status_code
);

/* 31051 bt_sdp_browse_line — one line of the last browse, by index. */
routine bt_sdp_browse_line(
	server		: mach_port_t;
	index		: int;
	out line	: bt_sdp_line;
	out status	: bt_status_code
);

skip;	/* 31052 */
skip;	/* 31053 */
skip;	/* 31054 */
skip;	/* 31055 */
skip;	/* 31056 */
skip;	/* 31057 */
skip;	/* 31058 */
skip;	/* 31059 */
skip;	/* 31060 */
skip;	/* 31061 */
skip;	/* 31062 */
skip;	/* 31063 */
skip;	/* 31064 */
skip;	/* 31065 */
skip;	/* 31066 */
skip;	/* 31067 */
skip;	/* 31068 */
skip;	/* 31069 */

/* ---- 31070-31099: profiles (HID, audio) --------------------------------- */

skip;	/* 31070 */
skip;	/* 31071 */
skip;	/* 31072 */
skip;	/* 31073 */
skip;	/* 31074 */
skip;	/* 31075 */
skip;	/* 31076 */
skip;	/* 31077 */
skip;	/* 31078 */
skip;	/* 31079 */
/*
 * 31080-31084 audio (#218, #219, #220). 31085-31089 stay free for the
 * hands-free gateway (#525).
 *
 * 31080 bt_audio_count — devices with audio right now: a headset we play to
 * (A2DP source), a phone playing to us (A2DP sink), or an AVRCP session.
 */
routine bt_audio_count(
	server		: mach_port_t;
	out count	: int;
	out status	: bt_status_code
);

/*
 * 31081 bt_audio_entry — one of them, by index. `role` and `route` are
 * audio_role_t and audio_route_t (audio.h: 1 source / 2 sink; 1 A2DP /
 * 2 HFP). `node` is the device programs open ("dsp.bt0"); `default_out` says
 * it also owns /dev/dsp. `volume` is AVRCP absolute volume, 0-127, or -1.
 */
routine bt_audio_entry(
	server		: mach_port_t;
	index		: int;
	out address	: bt_address;
	out role	: int;
	out route	: int;
	out active	: int;
	out avrcp	: int;
	out default_out	: int;
	out volume	: int;
	out node	: bt_node;
	out codec	: bt_transport;
	out status	: bt_status_code
);

/*
 * 31082 bt_audio_set — a paired device's Audio switch: whether bluetoothd
 * plays to it when it connects (PairedDevices/<addr>/Audio). Off stops a
 * mixer that runs.
 */
routine bt_audio_set(
	server		: mach_port_t;
	address		: bt_address;
	on		: int;
	out status	: bt_status_code
);

/*
 * 31083 bt_audio_volume — set a headset's volume (0-127) with AVRCP
 * SetAbsoluteVolume. not_connected without an AVRCP session;
 * operation_not_supported when the headset has no absolute volume.
 */
routine bt_audio_volume(
	server		: mach_port_t;
	address		: bt_address;
	volume		: int;
	out status	: bt_status_code
);

/*
 * 31084 bt_audio_policy — the audio preferences: AutoSwitchAudio (a headset
 * takes /dev/dsp) and A2DPSink (be a speaker). -1 leaves one as it is; the
 * values after the change come back.
 */
routine bt_audio_policy(
	server		: mach_port_t;
	autoswitch	: int;
	a2dp_sink	: int;
	out autoswitch_now : int;
	out a2dp_sink_now : int;
	out status	: bt_status_code
);
skip;	/* 31085 */
skip;	/* 31086 */
skip;	/* 31087 */
skip;	/* 31088 */
skip;	/* 31089 */
skip;	/* 31090 */
skip;	/* 31091 */
skip;	/* 31092 */
skip;	/* 31093 */
skip;	/* 31094 */
skip;	/* 31095 */
