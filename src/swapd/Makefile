# swapd — NextBSD's dynamic pager (nextbsd/nextbsd-userland#178).
#
# Builds /usr/sbin/swapd; runs as a launchd-managed daemon under
# overlay/System/Library/LaunchDaemons/org.nextbsd.swapd.plist.
#
# Plain libc + libsystem_kernel. The default_pager_alerts MIG server stub is
# generated by build-userland.sh from default_pager_alerts.defs (vendored from
# xnu-2422) and passed in MIGOUT=; a bare build without it fails at the
# generated #include "default_pager_alertsServer.h", as wland's does.
#
# Build:   make SYSROOT=/path/to/rootfs MIGOUT=/path/to/migout
# Install: make DESTDIR=/path/to/rootfs install

PROG=		swapd
MAN=		swapd.8
SRCS=		swapd.c

MIGOUT?=
.if !empty(MIGOUT)
.PATH:				${MIGOUT}
SRCS+=				default_pager_alertsServer.c
CFLAGS+=			-I${MIGOUT}
# Generated code is not WARNS-clean and must not gate the build.
CFLAGS.default_pager_alertsServer.c+=	-w
# <mach/notify.h> and <mach/message.h> both define the MACH_NOTIFY_* macros
# (same values); the same benign clash wland / ipconfigd document.
CFLAGS+=			-Wno-macro-redefined
.endif

# WARNS=0 with explicit warnings, as wland: the FreeBSD warning machinery adds
# -Werror at WARNS>0, and the libmach headers are not clean under it.
WARNS=		0
CFLAGS+=	-O2 -pipe
CFLAGS+=	-Wall -Wextra -Wshadow -Wstrict-prototypes
CFLAGS+=	-Wmissing-prototypes -Wpointer-arith

SYSROOT?=
.if !empty(SYSROOT)
CFLAGS+=	-I${SYSROOT}/usr/include
LDFLAGS+=	-L${SYSROOT}/usr/lib/system
LDFLAGS+=	-Wl,-rpath,/usr/lib/system
LDFLAGS+=	-Wl,--allow-shlib-undefined
.endif

#   -lsystem_kernel   mach_msg, the Mach port calls and macx_triggers()
LDADD+=		-lsystem_kernel

# Daemons go in /usr/sbin, as wland / ipconfigd; /System/Library holds data.
BINDIR=		/usr/sbin

.include <bsd.prog.mk>
