# nextbsd-fetch(1) -- the login banner (nextbsd/nextbsd-userland#298, E18 U16).
#
# Plain libc. It reads /etc/os-release and sysctl directly and links nothing,
# which is the point: neofetch is an archived shell script and fastfetch would
# be a pkg dependency in base.
#
# cube.h is generated by gencube.py, which is vendored beside it so the art
# can be re-cut rather than hand-edited. Regenerating is a deliberate act, so
# it is NOT a build rule: run `python3 gencube.py` and commit the result.
#
# Build:   make SYSROOT=/path/to/base
# Install: make DESTDIR=/path/to/stage install

PROG=		nextbsd-fetch
SRCS=		banner.c
MAN=		nextbsd-fetch.1
BINDIR=		/usr/bin
BINMODE=	0555
BINOWN=		root
BINGRP=		wheel

WARNS?=		6
CFLAGS+=	-I${.CURDIR}

SYSROOT?=
.if !empty(SYSROOT)
CFLAGS+=	--sysroot=${SYSROOT}
.endif

.include <bsd.prog.mk>
