/*
 * wlan.defs — Mach-RPC interface to wland.
 *
 * There is no Apple original to port here. Apple's equivalent surface lives
 * inside the closed wifid and is reached through the private Apple80211
 * framework; the only piece Apple ever published (eap8021x / eapolclient) does
 * the EAP exchange and nothing else. So this IDL is ours, and it is shaped to
 * two constraints:
 *
 *   1. EVERY ARGUMENT IS INLINE: a fixed-size array or a scalar. MIG out-of-line
 *      data was unusable when this interface was written; configd has used it
 *      since nextbsd#354, but nothing here needs it, and wlan_connect_eap's
 *      credentials should not travel in OOL pages anyway. So scan results use
 *      the flat indexed pattern ipconfigd established:
 *          wlan_scan_count()  then  wlan_scan_entry(i)
 *
 *   2. Scan results cannot go in the dynamic store either. CONFIG_DATA_MAX
 *      (config_types.h:74) rejects any key OR value over 8192 bytes, and a busy
 *      scan blows straight past that. Only the compact connected-state summary
 *      belongs in State:/.../AirPort; the scan list goes over this MIG surface.
 *
 * Subsystem base 30000: configd and ipconfigd both sit at 20000 (Apple ships
 * them that way and they never share a port set, so their id ranges collide
 * harmlessly). wland has no Apple original whose ids we need to match, so it
 * takes a range of its own rather than adding a third collision.
 *
 * The server demux _wlan_server() runs inside wland's mach_service_thread
 * receive loop. Per-routine implementations are in wland_mig.c.
 */

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

subsystem wlan 30000;
serverprefix _;

import "wlan_mig_types.h";

type wlan_ifname	= array[16] of char ctype: WLANInterfaceName;
type wlan_ssid		= array[33] of char ctype: WLANSSID;
type wlan_bssid		= array[18] of char ctype: WLANBSSID;
type wlan_psk		= array[65] of char ctype: WLANPassphrase;
type wlan_state		= MACH_MSG_TYPE_INTEGER_32 ctype: wlan_state_t;
type wlan_security	= MACH_MSG_TYPE_INTEGER_32 ctype: wlan_security_t;
type wlan_status_code	= MACH_MSG_TYPE_INTEGER_32 ctype: wlan_status_t;
type wlan_generation	= MACH_MSG_TYPE_INTEGER_32 ctype: uint32_t;
type wlan_eap_name	= array[256] of char ctype: WLANEAPName;
type wlan_eap_secret	= array[256] of char ctype: WLANEAPSecret;
type wlan_eap_path	= array[1024] of char ctype: WLANEAPPath;
type wlan_ttls_inner	= MACH_MSG_TYPE_INTEGER_32 ctype: wlan_ttls_inner_t;

/*
 * wlan_if_count / wlan_if_name — enumerate the WLAN interfaces wland owns.
 * These are the VAPs wland itself cloned, so the answer is authoritative in a
 * way getifaddrs is not (it cannot tell wlan0 from em0 by media type: net80211
 * VAPs go through ether_ifattach and report IFT_ETHER).
 */
routine wlan_if_count(
	server		: mach_port_t;
	out count	: int
);

routine wlan_if_name(
	server		: mach_port_t;
	index		: int;
	out name	: wlan_ifname;
	out status	: wlan_status_code
);

/*
 * wlan_scan — ask wpa_supplicant to scan on `name`. Returns as soon as the
 * scan is REQUESTED, not when it completes; results land asynchronously and the
 * caller polls wlan_scan_generation. A blocking scan RPC would hold a Mach reply
 * port open for the several seconds a full-band sweep takes.
 */
routine wlan_scan(
	server		: mach_port_t;
	name		: wlan_ifname;
	out status	: wlan_status_code
);

/* How many results are in wland's cache for `name` right now. */
routine wlan_scan_count(
	server		: mach_port_t;
	name		: wlan_ifname;
	out count	: int;
	out status	: wlan_status_code
);

/*
 * One scan result, by index. The flat-scalar shape is forced by the broken-OOL
 * constraint above — this is the same shape as ipconfig_if_count/if_addr, for
 * the same reason.
 */
routine wlan_scan_entry(
	server		: mach_port_t;
	name		: wlan_ifname;
	index		: int;
	out ssid	: wlan_ssid;
	out bssid	: wlan_bssid;
	out rssi	: int;
	out channel	: int;
	out security	: wlan_security;
	out status	: wlan_status_code
);

/*
 * wlan_connect — associate `name` with `ssid`, using `psk` (empty for an open
 * network). wland becomes the sole author of wpa_supplicant's network block for
 * this SSID and records it in SCPreferences as a known network.
 *
 * Like wlan_scan this returns once the association has been REQUESTED. The
 * caller watches State:/Network/Interface/<name>/AirPort (or polls
 * wlan_status) for the outcome — because the 4-way handshake takes time, and
 * because that key is the thing ipconfigd's DHCP gate keys on anyway.
 */
routine wlan_connect(
	server		: mach_port_t;
	name		: wlan_ifname;
	ssid		: wlan_ssid;
	psk		: wlan_psk;
	out status	: wlan_status_code
);

/* Disassociate, and stop autojoining this network until asked again. */
routine wlan_disconnect(
	server		: mach_port_t;
	name		: wlan_ifname;
	out status	: wlan_status_code
);

/*
 * wlan_status — the compact connected-state summary. Same information wland
 * publishes into State:/.../AirPort; offered here too so the CLI does not need
 * to link SystemConfiguration (and because there is no scutil in this port —
 * there is NO way to inspect the dynamic store ad hoc).
 */
routine wlan_status(
	server		: mach_port_t;
	name		: wlan_ifname;
	out state	: wlan_state;
	out ssid	: wlan_ssid;
	out bssid	: wlan_bssid;
	out rssi	: int;
	out channel	: int;
	out security	: wlan_security;
	out status	: wlan_status_code
);

/*
 * wlan_scan_generation — how many sweeps have finished on `name`, and whether
 * the latest one failed. wland bumps the counter after it has refreshed its
 * cache, so a caller that sees it pass the value read before wlan_scan can
 * read the results straight away. Polling this keeps wlan_scan asynchronous.
 *
 * New routines go at the END of this file: a routine's Mach message id is its
 * position in the subsystem.
 */
routine wlan_scan_generation(
	server		: mach_port_t;
	name		: wlan_ifname;
	out generation	: wlan_generation;
	out last_failed	: boolean_t;
	out status	: wlan_status_code
);

/*
 * wlan_connect_eap — join a WPA-Enterprise (802.1X) network. eap_type is 13
 * (TLS), 21 (TTLS) or 25 (PEAP), as in Darwin's AcceptEAPTypes. Unused strings
 * are empty. Like wlan_connect, this returns once the association has been
 * REQUESTED, and the network is remembered for autojoin.
 *
 * The server's certificate is verified unless no_verify_server is set; with
 * neither ca_cert nor server_name, and no opt-out, the call is refused.
 */
routine wlan_connect_eap(
	server			: mach_port_t;
	name			: wlan_ifname;
	ssid			: wlan_ssid;
	eap_type		: int;
	ttls_inner		: wlan_ttls_inner;
	identity		: wlan_eap_name;
	anonymous_identity	: wlan_eap_name;
	password		: wlan_eap_secret;
	ca_cert			: wlan_eap_path;
	server_name		: wlan_eap_name;
	client_cert		: wlan_eap_path;
	private_key		: wlan_eap_path;
	key_passphrase		: wlan_eap_secret;
	no_verify_server	: boolean_t;
	out status		: wlan_status_code
);
