#!/bin/sh
#
# WORKAROUND (nextbsd #280; to be removed by #281). NextBSD has no rc.d boot
# sequence -- launchd is PID 1 and nothing runs /etc/rc.d at boot. This script
# exists ONLY so the FreeBSD ports tree's shared-library post-installs (which
# hardcode `service ldconfig restart`) SUCCEED, and so the linker hints refresh
# on package install. It is invoked solely on-demand by service(8) from a pkg
# post-install -- never at boot. #281 replaces service(8) with a launchd-native
# shim and drops this file.
#
# PROVIDE: ldconfig

. /etc/rc.subr

name=ldconfig
start_cmd=ldconfig_start
stop_cmd=:
restart_cmd=ldconfig_start
status_cmd=:

# The hints list, in order: rtld's compiled-in default (nextbsd-freebsd-compat),
# then /etc/ld-elf.so.conf (nextbsd-overlays: /usr/X11/lib before
# /usr/local/lib, E23), then the ports' /usr/local/libdata/ldconfig drop-ins.
# rtld searches the hints before its default path, so the order here has to
# match it. Missing directories are skipped so ldconfig stays quiet.
ldconfig_start()
{
	local _dirs _d
	_dirs=
	for _d in /lib /usr/lib /usr/lib/system /System/Library/Libraries \
	    $(sed -e 's/#.*//' /etc/ld-elf.so.conf 2>/dev/null) \
	    /usr/local/lib \
	    $(sed -e 's/#.*//' /usr/local/libdata/ldconfig/* 2>/dev/null); do
		[ -d "$_d" ] && _dirs="$_dirs $_d"
	done
	/sbin/ldconfig -elf $_dirs
}

load_rc_config $name 2>/dev/null
run_rc_command "$1"
