#!/bin/sh
# network-mount -- mount the directory server's exports (org.nextbsd.network-mount).
#
# A server is asked about first and never mounts: Domain.plist in /Local means
# this machine owns the accounts, and mounting its own export back onto
# /Network would make every account tool treat it as somebody's client.
#
# Reads the server name from the binding plist that `dsjoin` writes,
#
#     /Local/Library/DirectoryServices/Binding.plist
#     <dict><key>server</key><string>HOST</string><key>version</key><integer>1</integer></dict>
#
# and mounts the two exports with -o bg: a first attempt that fails is
# retried by mount_nfs in the background, so this returns at once and a
# boot never waits on the network. Mounts already present are left alone.
# With no binding plist there is nothing to do and that is not an error.
#
# Both exports are the server's /Local paths, mounted onto this machine's
# /Network. A server shares /Local and moves nothing (#253), and an NFS export
# path and its mount point are independent -- which the /Local/Users line has
# always relied on. nss_directory_services then prefers the /Network copy and
# computes homes from it, so a client's homes land under /Network/Users while
# the server's own stay in /Local/Users.
# E18 U6, nextbsd/nextbsd-userland#252; the plist format is a contract with
# the directory commands (U7, #253).
set -u

BINDING=/Local/Library/DirectoryServices/Binding.plist
DOMAIN=/Local/Library/DirectoryServices/Domain.plist
OPTS=nfsv3,bg,intr,soft

if [ -e "$DOMAIN" ]; then
    echo "network-mount: this machine is a directory server; nothing to mount" >&2
    exit 0
fi

if [ ! -f "$BINDING" ]; then
    echo "network-mount: no $BINDING; not joined to a directory server" >&2
    exit 0
fi

# The value of the `server` key, wherever the writer put its line breaks.
server=$(tr -d '\n\r' < "$BINDING" | sed -E \
    's|.*<key>[[:space:]]*server[[:space:]]*</key>[[:space:]]*<string>([^<]*)</string>.*|\1|')
case "$server" in
    "" | *"<"* | *[!A-Za-z0-9.:-]*)
        echo "network-mount: $BINDING has no usable server name" >&2
        exit 1
        ;;
esac

mounted() {
    # The mount table shows resolved paths (/tmp -> private/tmp and so on).
    /sbin/mount -t nfs | /usr/bin/awk -v m="$(/bin/realpath "$1" 2>/dev/null || echo "$1")" \
        '$3 == m { found = 1 } END { exit !found }'
}

mount_one() {
    # $1 export on the server, $2 mount point
    /bin/mkdir -p "$2" || return 1
    if mounted "$2"; then
        echo "network-mount: $2 is already mounted" >&2
        return 0
    fi
    echo "network-mount: mounting $server:$1 on $2" >&2
    /sbin/mount -t nfs -o "$OPTS" "$server:$1" "$2"
}

rc=0
mount_one /Local/Library/DirectoryServices /Network/Library/DirectoryServices || rc=1
mount_one /Local/Users /Network/Users || rc=1
exit $rc
