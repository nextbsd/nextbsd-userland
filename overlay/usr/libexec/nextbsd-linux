#!/bin/sh
# nextbsd-linux — owner of the Linux ABI filesystems (nextbsd-userland#190).
#
# NextBSD has no rc.d, so nothing runs FreeBSD's rc.d/linux, and no
# /etc/fstab ships any more (nextbsd-overlays#5). This tool does rc.d/linux's
# job: it creates the mount points under the Linux emulation root
# ($emul = sysctl compat.linux.emul_path, default /compat/linux) and ALWAYS
# mounts the five Linux ABI filesystems there, whether or not a Linux userland
# is installed. That is exactly stock FreeBSD's behaviour with
# linux_enable=YES (rc.d/linux: mkdir -p, then mount, unconditionally).
#
# An empty-but-mounted root is useful on its own: the Linuxulator tries every
# absolute path under $emul first and falls back to the real root only on
# ENOENT (sys/kern/vfs_lookup.c), so Linux processes get Linux /proc, /sys,
# /dev/fd and /dev/shm while everything else resolves on the host. A root
# populated later (debootstrap, a tarball, linux_base) is already mounted.
# debootstrap unmounts $emul/proc on its way out; re-run this tool afterwards.
#
# Run at boot by launchctl bootstrap (support/launchctl.c,
# system_specific_bootstrap), next to the other boot-time mounts and before
# any LaunchDaemon starts, as `nextbsd-linux --boot`. Re-run by hand (as root)
# after populating a Linux root: `nextbsd-linux`.
#
# Design: https://pkgdemon.github.io/nextbsd-linux-abi-mounts-plan.html
#
# Usage: nextbsd-linux [--root PATH] [ACTION]
#   (none)       boot run: the compat set, plus the native set if
#                native_mounts=YES in the config
#   --compat     mount the compat set under $emul
#   --native     mount the native set (/proc, /sys, /dev/fd, /dev/shm)
#   --all        both sets
#   --unmount [--native|--all] [--force]
#                unmount the compat set (or native / both), reverse order;
#                never removes directories
#   --status [--json]
#                report each mount; exit 0 if every mount of the enabled sets
#                is present, 1 otherwise
#   --check      dry run: say what would be done, change nothing
#   --root PATH  use PATH instead of compat.linux.emul_path for this run
#   --boot       boot run from launchctl bootstrap: log to
#                /var/log/nextbsd-linux.log, one console line only on failure
#
# Config (optional, sh syntax): /etc/nextbsd-linux.conf
#   native_mounts=NO     mount the native set on boot runs too
#   shm_size=            tmpfs size for dev/shm: N% of hw.physmem, or bytes
#                        with an optional k/m/g suffix. Default 50%, or 25%
#                        when / is unionfs (RAM-backed live media)
#   shm_share=YES        with the native set, nullfs the compat shm onto
#                        /dev/shm instead of a second tmpfs (one size cap)
#   chroot_nullfs="/tmp" host dirs nullfs-mounted into $emul. /tmp is the one
#                        path a Linux root has its own copy of, so without this
#                        Linux programs would create files in a private /tmp that
#                        native programs never see (AppImage FUSE mounts, temp
#                        files). Homes need no mount: paths absent from the root
#                        fall back to the real filesystem. Entries that do not
#                        exist on this system are skipped. Set "" to disable.
#   fallback_brand=YES   set kern.elf64.fallback_brand=3 if it reads -1
#
# To move the root persistently, put compat.linux.emul_path=/compat/debian in
# /etc/sysctl.conf UNQUOTED (launchctl bootstrap applies that file before any
# LaunchDaemon starts, and sysctl(8) does not strip quotes).
#
# Exit codes: 0 ok / no-op, 1 usage, 2 mkdir failed or invalid root,
# 3 a different filesystem is already mounted on a path, 4 mount refused,
# 5 busy on unmount, 6 lock timeout. With several errors the highest code
# wins; every path is still attempted.

PATH=${NEXTBSD_LINUX_PATH:-/sbin:/bin:/usr/sbin:/usr/bin}
export PATH

PROG=nextbsd-linux
CONF=/etc/nextbsd-linux.conf
LOCK=/var/run/nextbsd-linux.lock

# --- serialise every run (boot, launchctl start, a wrapper) ------------------
if [ -z "${NEXTBSD_LINUX_LOCKED:-}" ]; then
	NEXTBSD_LINUX_LOCKED=1
	export NEXTBSD_LINUX_LOCKED
	lockf -k -t 60 "$LOCK" "$0" "$@"
	_r=$?
	if [ "$_r" -eq 75 ]; then	# lockf(1): EX_TEMPFAIL, timed out
		echo "$PROG: another run holds $LOCK (waited 60s)" >&2
		exit 6
	fi
	exit "$_r"
fi

# --- defaults, then config ---------------------------------------------------
native_mounts=NO
shm_size=
shm_share=YES
chroot_nullfs="/tmp"
fallback_brand=YES
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

usage() {
	sed -n '/^# Usage:/,/^# Config/p' "$0" | sed -e 's/^# \{0,1\}//' -e '$d' >&2
	exit 1
}

# --- arguments ---------------------------------------------------------------
action=boot
set_native=0
set_all=0
force=0
json=0
check=0
root_arg=
boot=0
while [ $# -gt 0 ]; do
	case "$1" in
	--compat)  action=compat ;;
	--native)  case "$action" in unmount|status) set_native=1 ;; *) action=native ;; esac ;;
	--all)     case "$action" in unmount|status) set_all=1 ;; *) action=all ;; esac ;;
	--unmount) action=unmount ;;
	--status)  action=status ;;
	--check)   check=1 ;;
	--force)   force=1 ;;
	--json)    json=1 ;;
	--root)    [ $# -ge 2 ] || usage; root_arg=$2; shift ;;
	--boot)    boot=1 ;;
	-h|--help) usage ;;
	*)         echo "$PROG: unknown argument: $1" >&2; usage ;;
	esac
	shift
done

# Boot run: everything to the log; keep the console (fd 3) for one summary
# line if something fails.
if [ "$boot" -eq 1 ]; then
	exec 3>&2 >>/var/log/nextbsd-linux.log 2>&1
	echo "--- $(date '+%Y-%m-%d %H:%M:%S') boot run"
fi

rc=0
fail() {	# fail CODE MESSAGE — record the highest code, keep going
	echo "$PROG: $2" >&2
	[ "$1" -gt "$rc" ] && rc=$1
	return 0
}
say() { [ "$json" -eq 1 ] || echo "$PROG: $*"; }

# --- the root ----------------------------------------------------------------
emul=${root_arg:-$(sysctl -n compat.linux.emul_path 2>/dev/null)}
emul=${emul:-/compat/linux}
emul=${emul%/}
case "$emul" in
/?*) ;;
*)   echo "$PROG: emulation root '$emul' is not an absolute path" >&2; exit 2 ;;
esac
if [ -e "$emul" ] && [ ! -d "$emul" ]; then
	echo "$PROG: emulation root $emul exists and is not a directory" >&2
	exit 2
fi
if [ -L "$emul" ] && [ ! -e "$emul" ]; then
	echo "$PROG: emulation root $emul is a dangling symlink" >&2
	exit 2
fi

# fstype mounted exactly on PATH (the top-most mount), or empty.
mounted_type() {
	_p=$(realpath "$1" 2>/dev/null) || _p=$1
	# 2>/dev/null: with no /etc/fstab, mount -p's putfsent() lookups print
	# "fstab: /etc/fstab:0: No such file or directory" per mount.
	mount -p 2>/dev/null | awk -v p="$_p" '$2 == p { t = $3 } END { print t }'
}

# --- /dev/shm size -----------------------------------------------------------
shm_bytes() {
	_spec=$shm_size
	if [ -z "$_spec" ]; then
		if [ "$(mounted_type /)" = unionfs ]; then _spec=25%; else _spec=50%; fi
	fi
	case "$_spec" in
	*%)
		_pct=${_spec%\%}
		_mem=$(sysctl -n hw.physmem)
		_pg=$(sysctl -n hw.pagesize)
		_b=$((_mem / 100 * _pct))
		_b=$((_b / _pg * _pg))
		_floor=$((128 * 1024 * 1024))
		[ "$_b" -lt "$_floor" ] && _b=$_floor
		echo "$_b"
		;;
	*)	echo "$_spec" ;;	# bytes, or k/m/g — tmpfs(5) parses it
	esac
}

# --- one mount ---------------------------------------------------------------
# mount_one FSTYPE PATH OPTS MKDIR(0|1) [SOURCE]
mount_one() {
	_fs=$1 _path=$2 _opts=$3 _mkdir=$4 _src=${5:-$1}
	if [ ! -d "$_path" ]; then
		if [ "$_mkdir" -eq 0 ]; then
			fail 2 "$_path is missing and is not ours to create (is $_fs's parent mounted?)"
			return
		fi
		if [ -L "$_path" ]; then
			# A dangling symlink, e.g. FreeBSD distribution's /sys -> usr/src/sys.
			if [ "$check" -eq 1 ]; then say "would replace dangling symlink $_path"; else
				rm -f "$_path" || { fail 2 "cannot remove dangling symlink $_path"; return; }
			fi
		fi
		if [ "$check" -eq 1 ]; then say "would mkdir $_path"; else
			mkdir -p "$_path" || { fail 2 "mkdir $_path failed"; return; }
		fi
	fi
	_have=$(mounted_type "$_path")
	if [ "$_have" = "$_fs" ]; then
		say "already $_fs $_path"
		return
	fi
	if [ -n "$_have" ]; then
		fail 3 "$_path already has $_have mounted, expected $_fs; not stacking"
		return
	fi
	if [ "$check" -eq 1 ]; then
		say "would mount $_fs $_path ($_opts)"
		return
	fi
	if _err=$(mount -t "$_fs" -o "nocover${_opts:+,$_opts}" "$_src" "$_path" 2>&1); then
		say "mounted $_fs $_path"
		return
	fi
	# EBUSY from nocover: a concurrent run beat us, or something else is there.
	_have=$(mounted_type "$_path")
	if [ "$_have" = "$_fs" ]; then
		say "already $_fs $_path"
	elif [ -n "$_have" ]; then
		fail 3 "$_path already has $_have mounted, expected $_fs; not stacking"
	else
		fail 4 "mount -t $_fs $_path failed: $_err"
	fi
}

# --- the sets, in dependency order -------------------------------------------
# devfs before fdescfs and the shm tmpfs: devfs supplies fd/, and
# linux_dev_shm_create() puts shm/ in every devfs instance at ABI init, so
# neither needs (or allows) mkdir.
do_compat() {
	mount_one linprocfs "$emul/proc"    ""                    1
	mount_one linsysfs  "$emul/sys"     ""                    1
	mount_one devfs     "$emul/dev"     ""                    1
	mount_one fdescfs   "$emul/dev/fd"  "linrdlnk"            0
	mount_one tmpfs     "$emul/dev/shm" "mode=1777,size=$(shm_bytes)" 0
	for _d in $chroot_nullfs; do
		case "$_d" in /?*) ;; *) fail 1 "chroot_nullfs entry '$_d' is not absolute"; continue ;; esac
		if [ ! -d "$_d" ]; then
			say "skip nullfs $_d (not present on this system)"
			continue
		fi
		mount_one nullfs "$emul$_d" "" 1 "$_d"
	done
}

do_native() {
	mount_one linprocfs /proc   ""         1
	mount_one linsysfs  /sys    ""         1
	mount_one fdescfs   /dev/fd "linrdlnk" 0
	if [ "$shm_share" = YES ] && [ "$(mounted_type "$emul/dev/shm")" = tmpfs ]; then
		mount_one nullfs /dev/shm "" 0 "$emul/dev/shm"
	else
		mount_one tmpfs /dev/shm "mode=1777,size=$(shm_bytes)" 0
	fi
}

do_brand() {
	[ "$fallback_brand" = YES ] || return 0
	_b=$(sysctl -n kern.elf64.fallback_brand 2>/dev/null) || return 0
	if [ "$_b" = "-1" ]; then
		if [ "$check" -eq 1 ]; then say "would set kern.elf64.fallback_brand=3"; else
			sysctl kern.elf64.fallback_brand=3 >/dev/null && say "set kern.elf64.fallback_brand=3"
		fi
	fi
}

# --- unmount, reverse order --------------------------------------------------
umount_one() {	# umount_one FSTYPE PATH
	[ "$(mounted_type "$2")" = "$1" ] || return 0
	if [ "$check" -eq 1 ]; then say "would unmount $1 $2"; return; fi
	if [ "$force" -eq 1 ]; then _e=$(umount -f "$2" 2>&1); else _e=$(umount "$2" 2>&1); fi
	if [ $? -eq 0 ]; then say "unmounted $1 $2"; else fail 5 "umount $2 failed: $_e"; fi
}

undo_compat() {
	for _d in $chroot_nullfs; do umount_one nullfs "$emul$_d"; done
	umount_one tmpfs     "$emul/dev/shm"
	umount_one fdescfs   "$emul/dev/fd"
	umount_one devfs     "$emul/dev"
	umount_one linsysfs  "$emul/sys"
	umount_one linprocfs "$emul/proc"
}

undo_native() {
	_t=$(mounted_type /dev/shm)
	case "$_t" in nullfs|tmpfs) umount_one "$_t" /dev/shm ;; esac
	umount_one fdescfs   /dev/fd
	umount_one linsysfs  /sys
	umount_one linprocfs /proc
}

# --- status ------------------------------------------------------------------
st_first=1
st_bad=0
st_line() {	# st_line SET FSTYPE PATH
	_have=$(mounted_type "$3")
	if [ "$_have" = "$2" ]; then _s=mounted
	elif [ -z "$_have" ]; then _s=missing; st_bad=1
	else _s="conflict($_have)"; st_bad=1
	fi
	if [ "$json" -eq 1 ]; then
		[ "$st_first" -eq 1 ] || printf ',\n'
		printf '    {"set": "%s", "fstype": "%s", "path": "%s", "state": "%s"}' "$1" "$2" "$3" "$_s"
		st_first=0
	else
		printf '%-7s %-10s %-28s %s\n' "$1" "$2" "$3" "$_s"
	fi
}

do_status() {
	_native=$native_mounts
	if [ "$json" -eq 1 ]; then
		printf '{\n  "emul_path": "%s",\n  "fallback_brand": "%s",\n  "shm_size": "%s",\n  "native_mounts": "%s",\n  "mounts": [\n' \
		    "$emul" "$(sysctl -n kern.elf64.fallback_brand 2>/dev/null)" "$(shm_bytes)" "$_native"
	else
		echo "emul_path       $emul"
		echo "fallback_brand  $(sysctl -n kern.elf64.fallback_brand 2>/dev/null)"
		echo "shm_size        $(shm_bytes) bytes"
		echo "native_mounts   $_native"
	fi
	st_line compat linprocfs "$emul/proc"
	st_line compat linsysfs  "$emul/sys"
	st_line compat devfs     "$emul/dev"
	st_line compat fdescfs   "$emul/dev/fd"
	st_line compat tmpfs     "$emul/dev/shm"
	for _d in $chroot_nullfs; do [ -d "$_d" ] && st_line compat nullfs "$emul$_d"; done
	if [ "$_native" = YES ]; then
		st_line native linprocfs /proc
		st_line native linsysfs  /sys
		st_line native fdescfs   /dev/fd
		if [ "$shm_share" = YES ]; then st_line native nullfs /dev/shm; else st_line native tmpfs /dev/shm; fi
	fi
	[ "$json" -eq 1 ] && printf '\n  ]\n}\n'
	return $st_bad
}

# --- dispatch ----------------------------------------------------------------
case "$action" in
boot)
	do_compat
	[ "$native_mounts" = YES ] && do_native
	do_brand
	;;
compat)  do_compat; do_brand ;;
native)  do_native ;;
all)     do_compat; do_native; do_brand ;;
unmount)
	if [ "$set_all" -eq 1 ]; then undo_native; undo_compat
	elif [ "$set_native" -eq 1 ]; then undo_native
	else undo_compat
	fi
	;;
status)
	[ "$set_native" -eq 1 ] || [ "$set_all" -eq 1 ] && native_mounts=YES
	do_status
	exit $?
	;;
esac

if [ "$boot" -eq 1 ] && [ "$rc" -ne 0 ]; then
	echo "$PROG: Linux ABI mounts incomplete (exit $rc); see /var/log/nextbsd-linux.log" >&3
fi
exit $rc
