/*
 * nss_nextbsd: the `nextbsd` source for the passwd and group databases in
 * nsswitch.conf(5) inside the /compat/linux (glibc) root. The glibc
 * counterpart of the host's nss_directory_services module. It exposes glibc's
 * _nss_* ABI (not FreeBSD's ns_mtab table) over the same portable dsdb core,
 * and packs into glibc's struct passwd/group. A missing or unparsable plist
 * makes the source unavailable, so the next source (files) answers.
 */
#define _GNU_SOURCE

#include <errno.h>
#include <grp.h>
#include <nss.h>
#include <pthread.h>
#include <pwd.h>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>

#include "dsdb.h"

/*
 * The status values are glibc's enum nss_status, named NSS_STATUS_* in every
 * modern glibc (>= 2.31: excalibur is 2.36, the box is 2.41). We are built
 * natively in-chroot against the base's own glibc, so we reference those
 * enumerators directly. No compat shim: an enumerator is invisible to the
 * preprocessor, so an `#ifndef NSS_STATUS_*` fallback would always misfire and
 * try to redefine them in terms of the absent classic NSS_* names.
 */

static size_t pw_cursor;
static size_t gr_cursor;

/* Re-arm the dsdb mutex after a fork so the single-threaded child does not
 * inherit it locked. (glibc has no module register hook; a constructor runs
 * when the module is dlopen'ed, which is the right moment.) */
static void
nbs_init(void)
{
	(void)pthread_atfork(dsdb_lock, dsdb_unlock, dsdb_atfork_child);
}
__attribute__((constructor)) static void nbs_ctor(void) { nbs_init(); }

/* Copy s into the buffer cursor; NULL when it does not fit. */
static char *
put(char **cur, char *end, const char *s)
{
	size_t n = strlen(s) + 1;
	char *at = *cur;

	if ((size_t)(end - at) < n)
		return (NULL);
	memcpy(at, s, n);
	*cur += n;
	return (at);
}

/* Pack a record into glibc's struct passwd from the caller's buffer. The
 * record's strings are copied into the buffer (they must not point at the
 * dsdb cache, which a reload frees); home is /Local|/Network/Users/<name>. */
static int
pack_passwd(const struct ds_user *u, int privileged, int network,
    struct passwd *pw, char *buf, size_t buflen)
{
	const char *passwd;
	char *cur = buf, *end = buf + buflen;
	int rv;

	if (privileged)
		passwd = u->nopass ? "" : (u->hash != NULL ? u->hash : "*");
	else
		passwd = "*";

	memset(pw, 0, sizeof(*pw));
	if ((pw->pw_name = put(&cur, end, u->name)) == NULL ||
	    (pw->pw_passwd = put(&cur, end, passwd)) == NULL ||
	    (pw->pw_gecos = put(&cur, end, u->real)) == NULL)
		return (ERANGE);
	rv = snprintf(cur, (size_t)(end - cur), "%s/Users/%s",
	    network ? "/Network" : "/Local", u->name);
	if (rv < 0 || (size_t)rv >= (size_t)(end - cur))
		return (ERANGE);
	pw->pw_dir = cur;
	cur += rv + 1;
	if ((pw->pw_shell = put(&cur, end, u->shell)) == NULL)
		return (ERANGE);
	pw->pw_uid = u->uid;
	pw->pw_gid = u->gid;
	return (0);
}

/* Pack a record into glibc's struct group. The member pointer array goes
 * first (aligned), then the strings. */
static int
pack_group(const struct ds_group *g, struct group *grp, char *buf, size_t buflen)
{
	char **mem;
	char *cur, *end = buf + buflen;
	size_t i, align, need;

	align = (size_t)(-(intptr_t)buf) & (sizeof(char *) - 1);
	need = align + (g->nmembers + 1) * sizeof(char *);
	if (need > buflen)
		return (ERANGE);
	mem = (char **)(void *)(buf + align);
	cur = buf + need;

	memset(grp, 0, sizeof(*grp));
	if ((grp->gr_name = put(&cur, end, g->name)) == NULL ||
	    (grp->gr_passwd = put(&cur, end, "x")) == NULL)
		return (ERANGE);
	for (i = 0; i < g->nmembers; i++)
		if ((mem[i] = put(&cur, end, g->members[i])) == NULL)
			return (ERANGE);
	mem[g->nmembers] = NULL;
	grp->gr_mem = mem;
	grp->gr_gid = g->gid;
	return (0);
}

/* ---- passwd -------------------------------------------------------------- */

enum nss_status
_nss_nextbsd_getpwuid_r(uid_t uid, struct passwd *pwd, char *buf, size_t n, int *errnop)
{
	const struct ds_user *u;
	int rv;

	dsdb_lock();
	if (dsdb_refresh_users() != DSDB_OK) {
		dsdb_unlock();
		return (NSS_STATUS_UNAVAIL);
	}
	u = dsdb_user_by_uid(uid);
	if (u == NULL) {
		dsdb_unlock();
		return (NSS_STATUS_NOTFOUND);
	}
	rv = pack_passwd(u, geteuid() == 0, dsdb_users_from_network(), pwd, buf, n);
	dsdb_unlock();
	if (rv != 0) {
		if (errnop != NULL)
			*errnop = rv;
		return (NSS_STATUS_TRYAGAIN);
	}
	return (NSS_STATUS_SUCCESS);
}

enum nss_status
_nss_nextbsd_getpwnam_r(const char *name, struct passwd *pwd, char *buf, size_t n, int *errnop)
{
	const struct ds_user *u;
	int rv;

	dsdb_lock();
	if (dsdb_refresh_users() != DSDB_OK) {
		dsdb_unlock();
		return (NSS_STATUS_UNAVAIL);
	}
	u = dsdb_user_by_name(name);
	if (u == NULL) {
		dsdb_unlock();
		return (NSS_STATUS_NOTFOUND);
	}
	rv = pack_passwd(u, geteuid() == 0, dsdb_users_from_network(), pwd, buf, n);
	dsdb_unlock();
	if (rv != 0) {
		if (errnop != NULL)
			*errnop = rv;
		return (NSS_STATUS_TRYAGAIN);
	}
	return (NSS_STATUS_SUCCESS);
}

enum nss_status
_nss_nextbsd_getpwent_r(struct passwd *pwd, char *buf, size_t n, int *errnop)
{
	const struct ds_user *u;
	int rv;

	dsdb_lock();
	if (dsdb_refresh_users() != DSDB_OK) {
		dsdb_unlock();
		return (NSS_STATUS_UNAVAIL);
	}
	u = dsdb_user_at(pw_cursor);
	if (u != NULL)
		pw_cursor++;
	if (u == NULL) {
		dsdb_unlock();
		return (NSS_STATUS_NOTFOUND);
	}
	rv = pack_passwd(u, geteuid() == 0, dsdb_users_from_network(), pwd, buf, n);
	if (rv != 0)
		pw_cursor--;		/* let the retry see this record */
	dsdb_unlock();
	if (rv != 0) {
		if (errnop != NULL)
			*errnop = rv;
		return (NSS_STATUS_TRYAGAIN);
	}
	return (NSS_STATUS_SUCCESS);
}

enum nss_status
_nss_nextbsd_setpwent(void)
{
	dsdb_lock();
	pw_cursor = 0;
	dsdb_unlock();
	return (NSS_STATUS_SUCCESS);
}

enum nss_status
_nss_nextbsd_endpwent(void)
{
	return (NSS_STATUS_SUCCESS);
}

/* ---- group --------------------------------------------------------------- */

enum nss_status
_nss_nextbsd_getgrgid_r(gid_t gid, struct group *grp, char *buf, size_t n, int *errnop)
{
