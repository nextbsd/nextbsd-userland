		dsdb_unlock();
		return (NSS_STATUS_UNAVAIL);
	}
	g = dsdb_group_by_gid(gid);
	if (g == NULL) {
		dsdb_unlock();
		return (NSS_STATUS_NOTFOUND);
	}
	rv = pack_group(g, grp, buf, n);
	dsdb_unlock();
	if (rv != 0) {
		if (errnop != NULL)
			*errnop = rv;
		return (NSS_STATUS_TRYAGAIN);
	}
	return (NSS_STATUS_SUCCESS);
}

