	if (rv != 0)
		gr_cursor--;
	dsdb_unlock();
	if (rv != 0) {
		if (errnop != NULL)
			*errnop = rv;
		return (NSS_STATUS_TRYAGAIN);
	}
	return (NSS_STATUS_SUCCESS);
}

enum nss_status
_nss_nextbsd_setgrent(void)
{
	dsdb_lock();
	gr_cursor = 0;
	dsdb_unlock();
	return (NSS_STATUS_SUCCESS);
}

enum nss_status
_nss_nextbsd_endgrent(void)
{
	return (NSS_STATUS_SUCCESS);
}
NBS_GLUE
}

# Install a compiler into the base, build the module natively into the base's
# NSS module dir, set the chroot nsswitch, then remove the compiler.
do_build() {
	e=$(real_emul)
	ma=$(multiarch)
	[ -x "$e/usr/bin/apt-get" ] || die "no apt-get in the base -- is the base provisioned?"

	# The module source goes under the base's /tmp (nullfs to the host), so
	# the in-chroot compiler can read it.
	# $scratch is the host-side path (real_emul + /tmp, nullfs to the host); the
	# in-chroot view of the same directory is /tmp/... (there is no /compat/linux
	# inside the chroot), so the chroot commands must use $scratch_in, not $scratch.
	scratch="$e/tmp/nbs-mod.$$"
	scratch_in="/tmp/nbs-mod.$$"
	rm -rf "$scratch"
	write_source "$scratch"
	mkdir -p "$e/usr/lib/$ma"

	info "installing a compiler in the base (transient)"
	# gcc provides the driver + libgcc; libc6-dev provides the C library headers
	# the module includes (stdio, pwd, grp, nss, pthread, sys/*). A fuller base
	# already has them; the minimal bootstrap base does not -- name both, since
	# `apt-get install gcc` alone does not pull libc6-dev.
	chroot "$e" /usr/bin/apt-get install -y --no-install-recommends gcc libc6-dev || die "apt-get install compiler failed"

	info "building libnss_nextbsd.so.2 natively in the base"
	if ! chroot "$e" /bin/sh -c "cd '$scratch_in' && /usr/bin/gcc -shared -fPIC -o /usr/lib/$ma/libnss_nextbsd.so.2 plist.c dsdb.c nss_nextbsd.c"; then
		rm -rf "$scratch"
		die "module build failed"
	fi
	rm -rf "$scratch"
	# glibc dlopen()s the *unversioned* module name (libnss_nextbsd.so), so a
	# symlink from that name onto the built .so.2 is required for the module to
	# be found at all; without it every lookup silently falls through to `files`.
	ln -sf libnss_nextbsd.so.2 "$e/usr/lib/$ma/libnss_nextbsd.so" || die "module symlink failed"
	chroot "$e" /bin/sh -c 'ldconfig' 2>/dev/null || info "warn: ldconfig not run (loader still scans the module dir)"

	# `nextbsd` first, then the stock `files` source: directory users resolve
	# from the plists; everyone else (system accounts) resolves from /etc.
	printf 'passwd: nextbsd files\ngroup: nextbsd files\nshadow: nextbsd files\n' > "$e/etc/nsswitch.conf"
	info "set $e/etc/nsswitch.conf (passwd/group/shadow: nextbsd files)"

	info "removing the compiler (leaving a minimal base)"
	chroot "$e" /usr/bin/apt-get remove -y --purge gcc 2>/dev/null || true
	chroot "$e" /usr/bin/apt-get autoremove -y --purge 2>/dev/null || true

	[ -f "$e/usr/lib/$ma/libnss_nextbsd.so.2" ] || die "module not installed"
	info "done: $e/usr/lib/$ma/libnss_nextbsd.so.2"
}

# DS accounts carry no password (noPassword); a sudo prompt would never be
# satisfiable. Grant the DirectoryServices `admin` group -- the privilege group
# the nss module treats as admins, whose members are the owner's accounts --
# passwordless sudo so they can escalate in the base. The `admin` group is
# resolvable in the base only via the module, so this rule belongs with the
# users step (and is inert, not harmful, if the module is absent).
do_sudo() {
	e=$(real_emul)
	d="$e/etc/sudoers.d/nextbsd"
	mkdir -p "$e/etc/sudoers.d"
	cat > "$d" <<'EOF'
# nextbsd-linux: passwordless sudo for the DirectoryServices admin group.
# Written by nextbsd-linux-users. The nss module makes the `admin` group
# resolvable in the base; DS accounts have no password (noPassword), so a
# sudo prompt would be unsatisfiable -- NOPASSWD lets them escalate.
%admin ALL=(ALL:ALL) NOPASSWD: ALL
EOF
	# chown/chmod inside the chroot: the host has no `root` *group* (only the
	# base does), so a host-side name chown would misfire on a base file.
	chroot "$e" /bin/sh -c 'chown root:root /etc/sudoers.d/nextbsd && chmod 0440 /etc/sudoers.d/nextbsd' || true
	# A custom base might lack the includedir the sudo package normally ships.
	if ! chroot "$e" /bin/sh -c 'grep -q "includedir /etc/sudoers.d" /etc/sudoers 2>/dev/null'; then
		printf '@includedir /etc/sudoers.d\n' >> "$e/etc/sudoers"
		info "added @includedir /etc/sudoers.d to $e/etc/sudoers"
	fi
	# Locate visudo inside the base (Debian/Devuan put it in /usr/sbin, but a
	# custom base might differ); validate the drop-in, and remove it if it is
	# malformed so the stock sudoers still works.
	if v=$(chroot "$e" /bin/sh -c 'command -v visudo' 2>/dev/null) && [ -n "$v" ]; then
		if ! chroot "$e" "$v" -c -f /etc/sudoers.d/nextbsd >/dev/null 2>&1; then
			rm -f "$d"
			info "warn: visudo rejected the drop-in; removed it (sudo still works)"
		fi
	else
		info "sudo/visudo not installed in the base; the drop-in is inert until it is"
	fi
	[ -f "$d" ] && info "wrote $d (%admin ALL=(ALL:ALL) NOPASSWD: ALL)"
}

require_root
do_build
do_sudo
