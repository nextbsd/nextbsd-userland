#!/bin/sh
#
# nextbsd-linux-users(8) -- give the /compat/linux (glibc) base a user-aware
# identity provider: the nss_nextbsd NSS module, built natively inside the base.
#
# nextbsd/nextbsd#529. Called at the end of nextbsd-linux-bootstrap, after the
# base is provisioned and its ABI + /tmp mounts are up. Run as root.
#
# The base ships no compiler and the bootstrap's base-only rule (nextbsd#527)
# forbids a host /usr/local one, so the build happens IN the base: write the
# vendored module source into the chroot, apt-get a compiler into the chroot,
# build libnss_nextbsd.so.2 natively (against the base's own glibc), set the
# chroot's /etc/nsswitch.conf, then remove the compiler, leaving a minimal base
# with just the module. The module reads the host's DirectoryServices plists
# through the /Local and /Network mounts (the same files the host uses), so a
# user's uid/gid/home/shell resolve inside the root; a missing plist makes the
# source unavailable and `files` answers.
#
# The source is vendored below (heredocs) -- there is no separate src/ tree: the
# module is a base-provisioning artifact and this script is the thing that builds
# it. The portable core (plist, dsdb) is a copy of src/nss_directory_services
# (keep the two in sync); only the nsswitch glue (nss_nextbsd.c) is new -- it
# speaks glibc's _nss_* ABI instead of FreeBSD's ns_mtab, and packs into glibc's
# struct passwd/group.

set -eu

die()  { printf 'nextbsd-linux-users: %s\n' "$*" >&2; exit 1; }
info() { printf 'nextbsd-linux-users: %s\n' "$*"; }

EMUL_FALLBACK=/compat/linux

emul_path() {
	p=$(sysctl -n compat.linux.emul_path 2>/dev/null || true)
	case $p in
	/*) printf '%s' "$p" ;;
	*)  printf '%s' "$EMUL_FALLBACK" ;;
	esac
}

real_emul() {
	e=$(emul_path); mkdir -p "$e" 2>/dev/null || true
	(cd "$e" 2>/dev/null && pwd -P) || printf '%s' "$e"
}

host_arch() {
	case $(uname -m) in
	amd64 | x86_64)  printf 'amd64' ;;
	arm64 | aarch64) printf 'arm64' ;;
	*)               die "unsupported host arch: $(uname -m)" ;;
	esac
}

# The Debian multiarch tuple for the base's NSS module dir.
multiarch() {
	case $(host_arch) in
	amd64) printf 'x86_64-linux-gnu' ;;
	arm64) printf 'aarch64-linux-gnu' ;;
	esac
}

require_root() { [ "$(id -u)" = 0 ] || die "must run as root"; }

# The module source, written into $1. It must be a directory visible inside the
# chroot -- the caller passes one under the base's /tmp (nullfs to the host).
write_source() {
	d=$1
	mkdir -p "$d"

	cat > "$d/plist.h" <<'NBS_PLIST_H'
/*-
 * SPDX-License-Identifier: BSD-2-Clause
 *
 * Copyright (c) 2026 Joseph Maloney
 *
 * Redistribution and use in source and binary forms, with or without
 * modification, are permitted provided that the following conditions
 * are met:
 * 1. Redistributions of source code must retain the above copyright
 *    notice, this list of conditions and the following disclaimer.
 * 2. Redistributions in binary form must reproduce the above copyright
 *    notice, this list of conditions and the following disclaimer in the
 *    documentation and/or other materials provided with the distribution.
 *
 * THIS SOFTWARE IS PROVIDED BY THE AUTHOR AND CONTRIBUTORS ``AS IS'' AND
 * ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
 * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
 * ARE DISCLAIMED.  IN NO EVENT SHALL THE AUTHOR OR CONTRIBUTORS BE LIABLE
 * FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL
 * DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS
 * OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
 * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT
 * LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
 * OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
 * SUCH DAMAGE.
 */

/*
 * Vendored into nextbsd-linux-users for the glibc nss_nextbsd module. Keep in
 * sync with src/nss_directory_services/plist.h. A small reader for XML property
 * lists: dict, array, string, integer, true and false, which is all the
 * DirectoryServices plists use. Other value types (real, date, data) are parsed
 * and kept as PL_OTHER so the document still loads. CoreFoundation is
 * deliberately not used: this runs inside every process that resolves a user or
 * group.
 */

#ifndef NBS_PLIST_H
#define NBS_PLIST_H

#include <stddef.h>

enum pl_type {
	PL_DICT,
	PL_ARRAY,
	PL_STRING,
	PL_INTEGER,
	PL_BOOL,
	PL_OTHER
};

struct pl_node {
	enum pl_type	 type;
	char		*key;		/* set on the children of a dict */
	char		*str;		/* PL_STRING */
	long long	 num;		/* PL_INTEGER, PL_BOOL (0 or 1) */
	struct pl_node	**children;	/* PL_DICT, PL_ARRAY */
	size_t		 nchildren;
};

/* Parse a whole document; returns the root value or NULL if malformed. */
struct pl_node	*pl_parse(const char *buf, size_t len);
void		 pl_free(struct pl_node *node);

/* Dict accessors. All return NULL / -1 when the key is absent or the value has
 * an unexpected type. Integers also accept a numeric string, and booleans also
 * accept an integer or the strings YES/NO/true/false. */
const struct pl_node	*pl_dict_get(const struct pl_node *dict, const char *key);
const char		*pl_dict_string(const struct pl_node *dict, const char *key);
int			 pl_dict_integer(const struct pl_node *dict, const char *key,
			    long long *out);
int			 pl_dict_bool(const struct pl_node *dict, const char *key,
			    int *out);

#endif /* NBS_PLIST_H */
NBS_PLIST_H

	cat > "$d/plist.c" <<'NBS_PLIST_C'
/*-
 * SPDX-License-Identifier: BSD-2-Clause
 *
 * Copyright (c) 2026 Joseph Maloney
 *
 * Redistribution and use in source and binary forms, with or without
 * modification, are permitted provided that the following conditions
 * are met:
 * 1. Redistributions of source code must retain the above copyright
 *    notice, this list of conditions and the following disclaimer.
 * 2. Redistributions in binary form must reproduce the above copyright
 *    notice, this list of conditions and the following disclaimer in the
 *    documentation and/or other materials provided with the distribution.
 *
 * THIS SOFTWARE IS PROVIDED BY THE AUTHOR AND CONTRIBUTORS ``AS IS'' AND
 * ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
 * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
 * ARE DISCLAIMED.  IN NO EVENT SHALL THE AUTHOR OR CONTRIBUTORS BE LIABLE
 * FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL
 * DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS
 * OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
 * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT
 * LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
 * OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
