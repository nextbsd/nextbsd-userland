# ~/.zshrc -- your settings for interactive zsh shells.
#
# NextBSD's defaults (prompt, history, completion, key bindings, colours,
# zsh-autosuggestions) come from /etc/zshrc, which runs before this file, so
# anything set here wins. Examples:
#
#   PROMPT='%~ %# '                 # a shorter prompt
#   alias ll='ls -lah'
#   setopt AUTO_CD                   # type a directory name to cd into it
#
# To turn the autosuggestions off, put NEXTBSD_ZSH_PLUGINS=no in ~/.zshenv.
# To skip /etc/zshrc altogether, put NEXTBSD_ZSHRC=no there instead.
