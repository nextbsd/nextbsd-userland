<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ufs.fs: the NextBSD ufs filesystem bundle (nextbsd-userland#194).
  Apple's bundle layout. CFBundleName is the NextBSD vfs type, which
  diskarbitrationd uses as DAVolumeKind and passes to mount -t.
  Contents/Resources/ufs.util is a symlink to /usr/libexec/fsutil.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleIdentifier</key>
	<string>org.nextbsd.filesystems.ufs</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ufs</string>
	<key>CFBundlePackageType</key>
	<string>fs  </string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1.0</string>
	<key>FSImplementation</key>
	<array>
		<string>kernel</string>
	</array>
	<key>FSMediaTypes</key>
	<dict>
		<key>516E7CB6-6ECF-11D6-8FF8-00022D09712B</key>
		<dict>
			<key>FSMediaProperties</key>
			<dict>
				<key>Content Hint</key>
				<string>516E7CB6-6ECF-11D6-8FF8-00022D09712B</string>
				<key>Leaf</key>
				<true/>
			</dict>
			<key>FSProbeArguments</key>
			<string>-p</string>
			<key>FSProbeExecutable</key>
			<string>ufs.util</string>
			<key>FSProbeOrder</key>
			<integer>1000</integer>
		</dict>
		<key>BSD_FFS</key>
		<dict>
			<key>FSMediaProperties</key>
			<dict>
				<key>Content Hint</key>
				<string>BSD_FFS</string>
				<key>Leaf</key>
				<true/>
			</dict>
			<key>FSProbeArguments</key>
			<string>-p</string>
			<key>FSProbeExecutable</key>
			<string>ufs.util</string>
			<key>FSProbeOrder</key>
			<integer>1000</integer>
		</dict>
		<key>Partitionless</key>
		<dict>
			<key>FSMediaProperties</key>
			<dict>
				<key>Leaf</key>
				<true/>
				<key>Whole</key>
				<true/>
			</dict>
			<key>FSProbeArguments</key>
			<string>-p</string>
			<key>FSProbeExecutable</key>
			<string>ufs.util</string>
			<key>FSProbeOrder</key>
			<integer>4000</integer>
		</dict>
	</dict>
	<key>FSPersonalities</key>
	<dict>
		<key>UFS</key>
		<dict>
			<key>FSName</key>
			<string>UNIX File System</string>
			<key>FSMountExecutable</key>
			<string>/sbin/mount</string>
			<key>FSMountArguments</key>
			<string>-t ufs</string>
			<key>FSRepairExecutable</key>
			<string>ufs.util</string>
			<key>FSRepairArguments</key>
			<string>-y</string>
			<key>FSVerificationExecutable</key>
			<string>/sbin/fsck_ufs</string>
			<key>FSVerificationArguments</key>
			<string>-n</string>
			<key>FSFormatExecutable</key>
			<string>/sbin/newfs</string>
			<key>FSFormatArguments</key>
			<string>-U</string>
			<key>FSFormatContentMask</key>
			<string>516E7CB6-6ECF-11D6-8FF8-00022D09712B</string>
		</dict>
	</dict>
</dict>
</plist>
