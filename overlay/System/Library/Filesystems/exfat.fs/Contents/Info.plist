<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  exfat.fs: the NextBSD exfat filesystem bundle (nextbsd-userland#194).
  Apple's bundle layout. CFBundleName is the NextBSD vfs type, which
  diskarbitrationd uses as DAVolumeKind and passes to mount -t.
  Contents/Resources/exfat.util is a symlink to /usr/libexec/fsutil.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleIdentifier</key>
	<string>org.nextbsd.filesystems.exfat</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>exfat</string>
	<key>CFBundlePackageType</key>
	<string>fs  </string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1.0</string>
	<key>FSImplementation</key>
	<array>
		<string>user</string>
	</array>
	<key>FSMediaTypes</key>
	<dict>
		<key>EBD0A0A2-B9E5-4433-87C0-68B6B72699C7</key>
		<dict>
			<key>FSMediaProperties</key>
			<dict>
				<key>Content Hint</key>
				<string>EBD0A0A2-B9E5-4433-87C0-68B6B72699C7</string>
				<key>Leaf</key>
				<true/>
			</dict>
			<key>FSProbeArguments</key>
			<string>-p</string>
			<key>FSProbeExecutable</key>
			<string>exfat.util</string>
			<key>FSProbeOrder</key>
			<integer>2000</integer>
		</dict>
		<key>Windows_NTFS</key>
		<dict>
			<key>FSMediaProperties</key>
			<dict>
				<key>Content Hint</key>
				<string>Windows_NTFS</string>
				<key>Leaf</key>
				<true/>
			</dict>
			<key>FSProbeArguments</key>
			<string>-p</string>
			<key>FSProbeExecutable</key>
			<string>exfat.util</string>
			<key>FSProbeOrder</key>
			<integer>2000</integer>
		</dict>
		<key>Partitionless</key>
		<dict>
			<key>FSMediaProperties</key>
			<dict>
				<key>Leaf</key>
				<true/>
				<key>Whole</key>
				<true/>
			</dict>
			<key>FSProbeArguments</key>
			<string>-p</string>
			<key>FSProbeExecutable</key>
			<string>exfat.util</string>
			<key>FSProbeOrder</key>
			<integer>4000</integer>
		</dict>
	</dict>
	<key>FSPersonalities</key>
	<dict>
		<key>ExFAT</key>
		<dict>
			<key>FSName</key>
			<string>ExFAT</string>
			<key>FSMountExecutable</key>
			<string>/usr/local/sbin/mount.exfat-fuse</string>
			<key>FSMountArguments</key>
			<string></string>
			<key>FSRepairExecutable</key>
			<string>exfat.util</string>
			<key>FSRepairArguments</key>
			<string>-y</string>
			<key>FSVerificationExecutable</key>
			<string>/usr/local/sbin/fsck.exfat</string>
			<key>FSVerificationArguments</key>
			<string>-n</string>
			<key>FSFormatExecutable</key>
			<string>/usr/local/sbin/mkfs.exfat</string>
			<key>FSFormatArguments</key>
			<string></string>
			<key>FSFormatContentMask</key>
			<string>EBD0A0A2-B9E5-4433-87C0-68B6B72699C7</string>
		</dict>
	</dict>
</dict>
</plist>
