<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.nextbsd.aslmanager</string>
	<key>Program</key>
	<string>/usr/sbin/aslmanager</string>
	<key>ProgramArguments</key>
	<array>
		<string>aslmanager</string>
	</array>
	<!--
	     Apple's shipped plist, restored (nextbsd-userland#143, #164).

	     Verified against macOS 26 /System/Library/LaunchDaemons/
	     com.apple.aslmanager.plist: MachServices + EnableTransactions +
	     EnablePressuredExit + POSIXSpawnType Interactive, and nothing else.
	     No RunAtLoad, no KeepAlive, no StartInterval -- yet `ps` on a Mac
	     shows aslmanager resident from boot.

	     That is not a contradiction. aslmanager is demand-launched ONCE, by
	     syslogd's trigger from db_asl_open() at first store open, and then
	     STAYS resident: Apple's managed path ran dispatch_main() and never
	     returned. Our aslmanager does the same with a bare mach_msg receive
	     loop instead (aslmanager.c:run_managed).

	     The two keys #164 called vestigial are the ones that make residency
	     safe, and are restored with it:

	       EnableTransactions   launchd will not kill the job mid-rotation
	       EnablePressuredExit  launchd MAY reclaim it under memory pressure,
	                            which is fine -- the next trigger brings it
	                            straight back

	     StartInterval is deliberately NOT here. #143 added it as a
	     substitute for the trigger, but it only arms an EVFILT_TIMER
	     (core.c:2885) with no dispatch at load, so it did not start the job
	     for the first hour of any boot -- and a clock is the wrong shape
	     anyway: rotation is warranted by the store crossing a size or age
	     bound, not by the hour.

	     StandardErrorPath/StandardOutPath are ours, not Apple's: the boot
	     suite reads this file for the ASLMANAGER-RESIDENT / -TRIGGERED
	     markers. `launchctl list` cannot substitute -- job_export()
	     (core.c:1095) always inserts LastExitStatus, so a job that never ran
	     prints the same "-  0" as one that exited cleanly.
	-->
	<!-- The job label is NextBSD's (org.nextbsd.*, nextbsd-userland#437), but
	     the Mach service name stays com.apple.aslmanager: clients look the
	     service up by that exact string. Do not rename one to match the other. -->
	<key>MachServices</key>
	<dict>
		<key>com.apple.aslmanager</key>
		<true/>
	</dict>
	<key>EnableTransactions</key>
	<true/>
	<key>EnablePressuredExit</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/aslmanager.stderr</string>
	<key>StandardOutPath</key>
	<string>/var/log/aslmanager.stderr</string>
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
</dict>
</plist>
