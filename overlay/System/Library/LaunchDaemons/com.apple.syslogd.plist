<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.syslogd</string>
	<!-- KeepAlive=true, matching Apple's shipped plist byte-for-byte.
	     Do NOT set it false, and do not add RunAtLoad.

	     Apple's syslogd has no RunAtLoad; it starts at load because
	     KeepAlive=true maps to j->ondemand = false (core.c:2450) and
	     job_keepalive() then returns "job configured to run
	     continuously" (core.c:6397). Flipping this to false makes
	     syslogd purely demand-launched -- and nothing on this image
	     ever sends to com.apple.system.logger, so it would never start
	     at all.

	     A previous comment here claimed RunAtLoad had been "DROPPED"
	     over a launch_msg(LAUNCH_KEY_CHECKIN) hang. RunAtLoad was never
	     present in this plist, so nothing was dropped; the actual change
	     was this boolean. The hang it described has no reproduction in
	     the tree, and configd and mDNSResponder both check in to launchd
	     as its children today without incident. syslogd also tolerates a
	     failed check-in by design (syslogd.c:339-350) -- it keeps
	     ingesting on /var/run/log and klog_in, losing only the ASL Mach
	     service.

	     The in-process plist scan used to force-start this job with
	     job_dispatch(j, kickstart=true), which bypasses job_keepalive()
	     entirely, so the flipped boolean was invisible until that scan
	     was removed. -->
	<key>KeepAlive</key>
	<true/>
	<key>EnableTransactions</key>
	<true/>
	<key>EnablePressuredExit</key>
	<false/>
	<key>POSIXSpawnType</key>
	<string>Adaptive</string>
	<key>ProgramArguments</key>
	<array>
<!--
	Un-comment the following lines to run syslogd with a sandbox profile.
	Sandbox profiles restrict processes from performing unauthorized
	operations; so it may be necessary to update the profile
	(/usr/share/sandbox/syslogd.sb) if any changes are made to the syslog
	configuration (/etc/syslog.conf).
-->
<!--
		<string>/usr/bin/sandbox-exec</string>
		<string>-f</string>
		<string>/usr/share/sandbox/syslogd.sb</string>
-->
		<string>/usr/sbin/syslogd</string>
	</array>
	<!-- Capture stderr for post-mortem diagnosis (Phase J runtime
	     iter 1 showed syslogd SEGV); drop once startup is stable. -->
	<key>StandardErrorPath</key>
	<string>/var/log/syslogd.stderr</string>
	<key>StandardOutPath</key>
	<string>/var/log/syslogd.stderr</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ASL_DISABLE</key>
		<string>1</string>
	</dict>
	<key>MachServices</key>
	<dict>
		<key>com.apple.system.logger</key>
		<true/>
	</dict>
	<key>Sockets</key>
	<dict>
		<!-- launchd owns the BSD syslog(3) sockets (nextbsd-userland#494),
		     as Darwin's syslogd plist does for /var/run/syslog. launchctl
		     binds them when this job is loaded, before getty and login run,
		     so a message sent before syslogd is up queues in the socket.
		     Without them libc's LOG_CONS fallback wrote login(1)'s
		     "login on console as ..." line to /dev/console on every boot.
		     syslogd's bsd_in adopts both at check-in. Modes match what
		     bsd_in set when it bound them itself: 0666 (438) for
		     /var/run/log, root-only 0600 (384) for /var/run/logpriv. -->
		<key>BSDSystemLogger</key>
		<dict>
			<key>SockPathName</key>
			<string>/var/run/log</string>
			<key>SockPathMode</key>
			<integer>438</integer>
			<key>SockType</key>
			<string>dgram</string>
		</dict>
		<key>BSDSystemLoggerPriv</key>
		<dict>
			<key>SockPathName</key>
			<string>/var/run/logpriv</string>
			<key>SockPathMode</key>
			<integer>384</integer>
			<key>SockType</key>
			<string>dgram</string>
		</dict>
<!--
	Un-comment the following lines to enable the network syslog protocol listener.
-->
<!--
		<key>NetworkListener</key>
		<dict>
			<key>SockServiceName</key>
			<string>syslog</string>
			<key>SockType</key>
			<string>dgram</string>
		</dict>
-->
	</dict>
</dict>
</plist>
