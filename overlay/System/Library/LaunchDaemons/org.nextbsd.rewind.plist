<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.nextbsd.rewind</string>
	<!--
	     Snapshots of home folders on each person's schedule, for Rewind
	     in File Viewer (nextbsd/nextbsd#707): every minute, on the machine
	     that holds the home datasets. Periodic only (StartInterval, no
	     RunAtLoad): each run does what is due and exits, so nothing stays
	     resident; the first run is a minute after boot.
	-->
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/nextbsd/rewind</string>
		<string>run</string>
	</array>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>StandardErrorPath</key>
	<string>/var/log/rewind.log</string>
</dict>
</plist>
