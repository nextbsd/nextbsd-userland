<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.nextbsd.rewind</string>
	<!--
	     Snapshots of home folders on each person's schedule, for Rewind
	     in File Viewer (nextbsd/nextbsd#707): once at boot and then every
	     minute, on the machine that holds the home datasets.
	-->
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/nextbsd/rewind</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>StandardErrorPath</key>
	<string>/var/log/rewind.log</string>
</dict>
</plist>
