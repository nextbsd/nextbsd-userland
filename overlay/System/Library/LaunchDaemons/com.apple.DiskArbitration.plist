<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.apple.DiskArbitration.plist

  Boot-time launchd plist for diskarbitrationd, NextBSD's DiskArbitration
  daemon.

  diskarbitrationd checks in for Apple's Mach service name,
  com.apple.DiskArbitration.diskarbitrationd (_kDADaemonName), which
  libDiskArbitration's DASessionCreate looks up (nextbsd-userland#197).
  It learns of storage from the kernel registry (/dev/ioregistry; hwregd is
  retired), models disks from GEOM, probes and mounts them on /Volumes,
  and serves client sessions over the DAServer.defs MIG protocol.

  The Label stays com.apple.DiskArbitration (the CI harness keys on it);
  Apple's is com.apple.diskarbitrationd. RunAtLoad + KeepAlive: the daemon
  must exist before anything is mounted (Apple has KeepAlive only), and a
  respawn posts com.apple.diskarbitrationd.launched so keep-alive client
  sessions reconnect. StandardErrorPath / StandardOutPath route the log to
  /var/log/diskarbitrationd.stderr, which the CI boot test dumps.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.apple.DiskArbitration</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/sbin/diskarbitrationd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>MachServices</key>
    <dict>
        <key>com.apple.DiskArbitration.diskarbitrationd</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/log/diskarbitrationd.stderr</string>
    <key>StandardErrorPath</key>
    <string>/var/log/diskarbitrationd.stderr</string>
</dict>
</plist>
