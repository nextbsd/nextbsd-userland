<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  org.nextbsd.ntpd.plist

  Time sync (E18 U5, nextbsd/nextbsd-userland#251). Base ntpd in the
  foreground (-n: do not fork) with -g, which lets the first correction be
  a large step, as FreeBSD's rc.d/ntpd does; a VM with a bad clock would
  otherwise refuse to sync. Configuration is /etc/ntp.conf from
  nextbsd-overlays, whose managed block dscli join fills with the
  directory server as the preferred source.

  Disabled by default. Turn it on with
      launchctl load -w /System/Library/LaunchDaemons/org.nextbsd.ntpd.plist
  and off with unload -w; this launchd keeps that choice in its overrides
  database across reboots (there is no `launchctl enable`).

  Runs as root: there is no ntpd user in master.passwd and no mac_ntpd
  here. StandardErrorPath follows the convention of the other daemons.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.nextbsd.ntpd</string>
    <key>Disabled</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/sbin/ntpd</string>
        <string>-n</string>
        <string>-g</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/ntpd.stderr</string>
</dict>
</plist>
